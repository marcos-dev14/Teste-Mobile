# Copie para .env. Nunca versione o .env.
NODE_ENV=development
# 0.0.0.0 para o emulador/dispositivo alcançarem a API pela rede do host.
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info

# Banco (docker compose up -d). Credenciais apenas para uso local.
DATABASE_URL=postgresql://ecommerce:ecommerce_local_only@127.0.0.1:5442/ecommerce
DATABASE_URL_TEST=postgresql://ecommerce:ecommerce_local_only@127.0.0.1:5442/ecommerce_test
DATABASE_POOL_MAX=10

# Gere com: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-com-no-minimo-32-caracteres
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Origens web permitidas (separadas por vírgula). Apps nativos não usam CORS.
# Ex.: Expo web em desenvolvimento.
CORS_ORIGINS=http://localhost:8081

RATE_LIMIT_ENABLED=true
# false, ou IPs/CIDRs do proxy reverso (ex.: 10.0.0.0/8). "true" é recusado em produção.
TRUST_PROXY=false

# Stripe — SOMENTE modo de teste. A API não sobe com chaves live (sk_live_/pk_live_).
# Dashboard do Stripe (modo de teste) → Developers → API keys.
STRIPE_SECRET_KEY=sk_test_coloque_sua_chave_de_teste
STRIPE_PUBLISHABLE_KEY=pk_test_coloque_sua_chave_de_teste
# Opcional: segredo exibido por `stripe listen --forward-to localhost:3333/v1/webhooks/stripe`.
# Sem ele o webhook responde 503 e a confirmação usa a reconciliação pelo servidor.
# STRIPE_WEBHOOK_SECRET=whsec_...
# Minutos de reserva de estoque para pedidos aguardando pagamento.
PAYMENT_RESERVATION_MINUTES=30
# Métodos oferecidos no checkout (credit_card, pix, boleto). Habilite só os disponíveis na conta Stripe.
PAYMENT_METHODS=credit_card,pix,boleto
# Boleto: dias até o vencimento (0–60) e dias extras de reserva para a confirmação (1 dia útil no Stripe).
BOLETO_EXPIRES_AFTER_DAYS=3
BOLETO_CONFIRMATION_GRACE_DAYS=4
